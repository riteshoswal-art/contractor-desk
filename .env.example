# Copy this file to .env.local and fill in the values yourself.
# .env.local is ignored by Git. Never commit real values or paste them into chat.

# Google Sheets (server-side only, via a service account)
# How to sign in: leave empty (or "key") to use GOOGLE_PRIVATE_KEY below, or
# "impersonation" for keyless LOCAL use through your own Google Cloud CLI
# sign-in (see "Keyless local sign-in" in README.md). Anything else is refused.
GOOGLE_AUTH_METHOD=
GOOGLE_SHEET_ID=
# The service account's address. Needed for both methods; with impersonation
# the app refuses to run unless Google confirms it is acting as exactly this.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Key method only. Keep the key in double quotes, on one line, with its \n
# markers. MUST stay empty when GOOGLE_AUTH_METHOD=impersonation.
GOOGLE_PRIVATE_KEY=

# Admin login for the matching pages (founder only). Without both of these the
# admin area stays locked. Password: at least 10 characters. Secret: at least
# 32 random characters (it signs the login cookie; never reuse the password).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Your OWN mobile number, used only to try the WhatsApp link with TEST records.
# TEST records can never lead to a contractor's number. Leave empty to block it.
TEST_CONTACT_PHONE=

# Leave empty (or TEST) while developing. REAL is only honoured by a
# production build, and only once the consent wording is final.
REGISTRATION_RECORD_TYPE=

# Google Gemini (server-side only). Unpaid tier: synthetic test text ONLY.
GEMINI_API_KEY=
# Optional. Leave empty to use the built-in default (gemini-3.5-flash-lite).
GEMINI_MODEL=
# Leave empty (Gemini off). Set to synthetic-tests only while the founder tries
# the AI features with made-up text. It is ignored whenever the record type is
# REAL, and request reading also needs the admin to be logged in.
GEMINI_MODE=
